# Local scratch import payloads
/tmp-import-*.json

# Ad hoc downloaded media/document samples
/test-fixtures/internet-downloads/

# Super Focus local, file-backed project state (never committed; never on VIDNAS)
/super-focus-projects/

# Motion Graphics Studio local, file-backed project state (never committed; never on VIDNAS)
/motion-graphics-projects/

# Idea Engine local, file-backed idea state (never committed; never on VIDNAS)
/idea-engine-state/

# Dependencies
node_modules/
/_ci/

# Local stale package-run archive (redundant copies of tracked runs)
package-runs/stale-runs/

# Local generated verification evidence (keep workflow handoffs/scout outputs tracked)
/reports/mutation-evidence-*/
/reports/five-gate-dry-run-fixes-evidence-*/
/reports/cockpit-*-evidence-*/

# Earth Studio v0.4 acceptance proof: real frame exports + rendered MP4 stay
# untracked (like all package-run media); acceptance/hashes.sha256 pins them.
package-runs/2026-08-07-earth-studio-v04-acceptance/earth-studio/frames/
package-runs/2026-08-07-earth-studio-v04-acceptance/earth-studio/renders/

# ComfyUI qualification evidence: local, file-backed machine state (records,
# fingerprints, render evidence) — never committed; fixtures ARE committed
# under config/comfyui/.
/state/comfyui-qualification/

# ComfyUI supervised-upgrade sessions + requalification permits: local live
# maintenance records — never committed (schemas/code/docs are).
/state/comfyui-upgrades/

# ComfyUI strong environment manifests: machine-specific cryptographic
# inventories — local evidence, never committed (config/comfyui/
# environments.json config IS committed).
/state/comfyui-environments/

# ComfyUI deployment events (supervised installs/rollbacks + backup records):
# local evidence — never committed (the deployment CONTRACT under
# config/presto/comfyui/ IS committed).
/state/comfyui-deployments/

# Repository-level execution ownership authority anchor. This machine-local,
# hash-chained state must survive package-run archival and is never evidence to commit.
/state/execution-ownership-authority/

# Earth Studio journey visual-acceptance gate: raw per-frame Earth Studio captures
# are large and local-only. Contact sheets + the observation record + SHA256SUMS
# are tracked; the raw PNGs are pinned by hash in SHA256SUMS-raw-captures.txt.
package-runs/2026-08-19-earth-studio-journey-visual-acceptance/observations/**/*.png
package-runs/2026-08-19-earth-studio-journey-visual-acceptance/rounds/**/*.png

# Earth Studio DIRECTOR acceptance gate: raw per-frame captures are large and
# local-only. Contact sheets, the manifest, direction.json and expected-decisions
# are tracked; raw PNGs are pinned in SHA256SUMS-raw-captures.txt.
package-runs/2026-08-19-earth-studio-director-acceptance/observations/**/*.png
package-runs/2026-08-19-earth-studio-director-acceptance/rounds/**/*.png

# DRAFT media (narration, proxy presenter, assembled drafts) stays untracked like
# all package-run media. Every byte is pinned by sha256 in the run's own
# manifests (draft-narration.json / draft-proxy-presenter.json /
# draft-assembly.json), and media/draft-assembly/work/ is a rebuildable cache
# whose whole purpose is to be thrown away and regenerated.
package-runs/*/media/draft-narration/
package-runs/*/media/draft-proxy-presenter/
package-runs/*/media/draft-assembly/

# Screen Capture V1 runtime state (spool, evidence, keys, receipts, browser profiles) — never committed
/media/screen-capture/
