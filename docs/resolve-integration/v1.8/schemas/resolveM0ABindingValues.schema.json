{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolveM0ABindingValues.v1.8",
  "title": "M0A binding values v1.8 (the identities a probe package must bind to)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_version",
    "purpose",
    "active_authority_shape",
    "retention_rule",
    "manifest_sha256_note",
    "values"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolveM0ABindingValues.v1.8"
    },
    "authority_version": {
      "const": "1.8.0"
    },
    "purpose": {
      "type": "string"
    },
    "active_authority_shape": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_rule": {
      "type": "string"
    },
    "manifest_sha256_note": {
      "type": "string"
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_version",
        "capture_allowlist_digest",
        "capture_allowlist_method_count",
        "closed_world_verification",
        "codec_version",
        "evidence_inventory_schema",
        "evidence_layers",
        "evidence_session_schema",
        "evidence_store_authority_class",
        "evidence_store_module",
        "evidence_store_sha256",
        "evidence_store_version",
        "path_identifier_constraints",
        "primitive_spec_sha256",
        "raw_frame_max_bytes",
        "raw_ingest_version",
        "raw_schema_id",
        "raw_schema_version",
        "reference_parser_sha256",
        "reference_parser_version",
        "schema_registry_file",
        "schema_registry_sha256",
        "stderr_retention",
        "stdout_retention",
        "trusted_shim_authority_sha256",
        "trusted_shim_file",
        "trusted_shim_sha256",
        "trusted_shim_source_path",
        "trusted_shim_source_sha256",
        "trusted_shim_version"
      ],
      "properties": {
        "authority_version": {
          "type": "string",
          "minLength": 1
        },
        "raw_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "codec_version": {
          "type": "string",
          "minLength": 1
        },
        "raw_ingest_version": {
          "type": "string",
          "minLength": 1
        },
        "raw_frame_max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "trusted_shim_version": {
          "type": "string",
          "minLength": 1
        },
        "trusted_shim_sha256": {
          "type": "string",
          "minLength": 1
        },
        "trusted_shim_source_path": {
          "type": "string",
          "minLength": 1
        },
        "trusted_shim_source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "trusted_shim_authority_sha256": {
          "type": "string",
          "minLength": 1
        },
        "capture_allowlist_digest": {
          "type": "string",
          "minLength": 1
        },
        "capture_allowlist_method_count": {
          "type": "integer",
          "minimum": 1
        },
        "reference_parser_version": {
          "type": "string",
          "minLength": 1
        },
        "reference_parser_sha256": {
          "type": "string",
          "minLength": 1
        },
        "primitive_spec_sha256": {
          "type": "string",
          "minLength": 1
        },
        "schema_registry_sha256": {
          "type": "string",
          "minLength": 1
        },
        "schema_registry_file": {
          "type": "string",
          "minLength": 1
        },
        "trusted_shim_file": {
          "type": "string",
          "minLength": 1
        },
        "evidence_store_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_session_schema": {
          "type": "string",
          "minLength": 1
        },
        "evidence_inventory_schema": {
          "type": "string",
          "minLength": 1
        },
        "evidence_store_module": {
          "type": "string",
          "minLength": 1
        },
        "evidence_store_sha256": {
          "type": "string",
          "minLength": 1
        },
        "evidence_store_authority_class": {
          "type": "string",
          "minLength": 1
        },
        "closed_world_verification": {
          "type": "string",
          "minLength": 1
        },
        "path_identifier_constraints": {
          "type": "string",
          "minLength": 1
        },
        "evidence_layers": {
          "type": "string",
          "minLength": 1
        },
        "stdout_retention": {
          "type": "string",
          "minLength": 1
        },
        "stderr_retention": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
