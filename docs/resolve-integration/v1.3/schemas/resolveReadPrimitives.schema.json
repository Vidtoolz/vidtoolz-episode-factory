{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolveReadPrimitives.v1.3",
  "title": "Logical read operation -> primitive mapping (v1.3: target requirements, probe flags)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "law",
    "logical_operations"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolveReadPrimitives.v1.3"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "FROZEN_NOW"
      ]
    },
    "law": {
      "type": "string"
    },
    "logical_operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "primitives",
          "target_requirement"
        ],
        "properties": {
          "purpose": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "why_allowed": {
            "type": "string"
          },
          "target_requirement": {
            "enum": [
              "SESSION",
              "PROJECT",
              "PROJECT_TIMELINE"
            ]
          },
          "purpose_is_qualification": {
            "type": "boolean"
          },
          "read_only": {
            "type": "boolean"
          },
          "promotes_capability": {
            "const": false
          },
          "evidence_output": {
            "const": "CANDIDATE_EVIDENCE"
          },
          "primitives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "evidence_class",
                "evidence_ref",
                "milestones_available",
                "fallback_if_unqualified",
                "probe_allowed"
              ],
              "properties": {
                "method": {
                  "type": "string"
                },
                "evidence_class": {
                  "enum": [
                    "QUALIFIED_READ",
                    "DOCUMENTED_NOT_QUALIFIED",
                    "NOT_TESTED",
                    "UNSUPPORTED",
                    "BLOCKED",
                    "QUALIFIED_EF_SIDE"
                  ]
                },
                "evidence_ref": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "milestones_available": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "M0",
                      "M1",
                      "M2",
                      "M3"
                    ]
                  }
                },
                "fallback_if_unqualified": {
                  "enum": [
                    "MARK_UNAVAILABLE",
                    "DOWNGRADE_COVERAGE",
                    "REFUSE",
                    "PROBE_ONLY"
                  ]
                },
                "probe_allowed": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
