{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolveFindingResolutionMatrix.v1.10",
  "title": "Finding resolution matrix v1.7 (Codex v1.6 adjudication)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_version",
    "adjudication",
    "law",
    "operational_closure",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolveFindingResolutionMatrix.v1.10"
    },
    "authority_version": {
      "const": "1.20.0"
    },
    "adjudication": {
      "type": "string"
    },
    "law": {
      "type": "string"
    },
    "operational_closure": {
      "type": "string"
    },
    "inherited_matrices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "codex_finding",
          "correction",
          "negative_fixture",
          "expected_layer",
          "validation_sections"
        ],
        "properties": {
          "id": {
            "pattern": "^(C16-(B|M)[0-9]|ES-[0-9]|S19-[0-9]|S110-[0-9]|F110-[A-D]|V112-(RP1|[1-4])|V113-B1|V114-(B[1-4]|M1|N1)|V115-(B1|M1)|V116-B1|V117-(I1|S[1-5])|V118-(M[1-4]|N[1-3])|V119-F[1-5]|P1-(F(07|08|09|10|11|12)|R0[1-5])|F-120-0[1-8])$"
          },
          "severity": {
            "type": "string",
            "pattern": "^(BLOCKER|MAJOR|MINOR|MERGE MAJOR|OPERATIONAL)( / M0A MAJOR)?( \\(.+\\))?$"
          },
          "codex_finding": {
            "type": "string",
            "minLength": 20
          },
          "v16_defect": {
            "type": "string",
            "minLength": 20
          },
          "prior_defect": {
            "type": "string",
            "minLength": 20
          },
          "correction": {
            "type": "string",
            "minLength": 20
          },
          "negative_fixture": {
            "type": "string",
            "minLength": 20
          },
          "expected_layer": {
            "type": "string",
            "minLength": 3
          },
          "validation_sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
