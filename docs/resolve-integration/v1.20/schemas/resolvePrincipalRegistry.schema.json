{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolvePrincipalRegistry.v1",
  "title": "Principal registry v1 (role-bound operational labels; not authenticated identities)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_version",
    "law",
    "roles",
    "registry",
    "write_grants",
    "state_grants",
    "role_separation",
    "actor_disjointness_now",
    "verification_results",
    "enforced_by"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolvePrincipalRegistry.v1"
    },
    "authority_version": {
      "const": "1.20.0"
    },
    "law": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "enum": [
          "PREPARER",
          "VERIFIER",
          "APPROVER"
        ]
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]+:[A-Za-z0-9._-]+$"
        }
      }
    },
    "write_grants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "state_grants": {
      "type": "object"
    },
    "role_separation": {
      "type": "string"
    },
    "actor_disjointness_now": {
      "type": "object"
    },
    "verification_results": {
      "type": "array",
      "items": {
        "enum": [
          "PASS",
          "FAIL"
        ]
      }
    },
    "enforced_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
