{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolveCommitManifest.v1",
  "title": "Commit manifest head (PROVISIONAL_UNTIL_M3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_observation_sha256",
    "binding_set_digest",
    "ef_source_pins",
    "guard_digest",
    "journal_head_sha256",
    "plan_digest",
    "published_at",
    "receipt_sha256",
    "schema",
    "terminal_state",
    "transaction_id",
    "unresolved_conflicts",
    "verification_result_sha256"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolveCommitManifest.v1"
    },
    "transaction_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "terminal_state": {
      "enum": [
        "COMMITTED",
        "COMMITTED_RECOVERED"
      ]
    },
    "binding_observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding_set_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journal_head_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ef_source_pins": {
      "type": "object"
    },
    "published_at": {
      "type": "string"
    },
    "verification_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "guard_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Commit eligibility is never a naked terminal state: semantic_commit_manifest links journal identity/head, VERIFIED verification result digest, guard digest, terminal state, empty unresolved_conflicts and required evidence digests."
}
