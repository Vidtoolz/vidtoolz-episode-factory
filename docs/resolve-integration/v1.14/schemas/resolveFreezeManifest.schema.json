{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vidtoolz.resolveFreezeManifest.v1.10",
  "title": "Freeze manifest v1.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle",
    "version",
    "frozen_at",
    "approval_status",
    "approver",
    "parent",
    "status_vocabulary",
    "files",
    "external_pins",
    "counts"
  ],
  "properties": {
    "schema": {
      "const": "vidtoolz.resolveFreezeManifest.v1.10"
    },
    "bundle": {
      "const": "docs/resolve-integration/v1.14"
    },
    "version": {
      "const": "1.14.0"
    },
    "frozen_at": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string"
    },
    "approval_status": {
      "enum": [
        "CANDIDATE_FOR_INDEPENDENT_REVIEW",
        "APPROVED",
        "SUPERSEDED"
      ]
    },
    "approver": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "branch",
        "head",
        "semantic_head",
        "manifest_sha256",
        "immutable",
        "ancestors"
      ],
      "properties": {
        "version": {
          "const": "1.13.0"
        },
        "branch": {
          "const": "docs/resolve-authority-freeze-v1.13"
        },
        "head": {
          "const": "65895c6dedceadff012a08c1bafcdf9e92b65221"
        },
        "semantic_head": {
          "const": "65895c6dedceadff012a08c1bafcdf9e92b65221"
        },
        "manifest_sha256": {
          "const": "436e12c8616ea6704fef2dbd0e14517cf33092aec1a7ff064dd4b10fb3dad573"
        },
        "immutable": {
          "const": true
        },
        "ancestors": {
          "type": "array",
          "minItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "branch",
              "head",
              "manifest_sha256"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "baseline": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "status_vocabulary": {
      "const": [
        "FROZEN_NOW",
        "PROVISIONAL_UNTIL_M3",
        "UNTESTED_BLOCKED"
      ]
    },
    "status_field_law": {
      "type": "string"
    },
    "rules": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "status",
          "authority_class",
          "inherited_from_parent",
          "changed_from_parent",
          "new_in_this_version"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "FROZEN_NOW",
              "PROVISIONAL_UNTIL_M3",
              "UNTESTED_BLOCKED"
            ]
          },
          "authority_class": {
            "enum": [
              "NORMATIVE",
              "SCHEMA",
              "FIXTURE",
              "TOOL",
              "HISTORICAL_INPUT",
              "REPORT"
            ]
          },
          "inherited_from_parent": {
            "type": "boolean"
          },
          "changed_from_parent": {
            "type": "boolean"
          },
          "new_in_this_version": {
            "type": "boolean"
          },
          "qualification_note": {
            "type": "string"
          },
          "blocked_until": {
            "type": "string"
          }
        }
      }
    },
    "removed_from_this_version_present_in_parent": {
      "type": "array"
    },
    "external_pins": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    }
  },
  "$comment": "semantic_manifest additionally requires on-disk sha256 AND byte count equality for every listed file."
}
