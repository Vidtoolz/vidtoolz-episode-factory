                        },
                        "source_start": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "$rational"
                              ],
                              "properties": {
                                "$rational": {
                                  "type": "string",
                                  "pattern": "^[0-9]+/[1-9][0-9]*$"
                                }
                              }
                            }
                          ]
                        },
                        "source_end": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "$rational"
                              ],
                              "properties": {
                                "$rational": {
                                  "type": "string",
                                  "pattern": "^[0-9]+/[1-9][0-9]*$"
                                }
                              }
