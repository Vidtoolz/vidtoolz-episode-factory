  "runtime_lookup_law": "NO authorizing runtime code resolves a function by name from any artifact. Functions are bound statically by Python import; there is no getattr/eval/dispatch-table lookup keyed on an artifact string anywhere in the authority. A stale artifact can therefore mislead a HUMAN or an external consumer - which is why this file exists and why the validator compares every current artifact against it - but it cannot make the authority itself call a diagnostic function.",
  "receipt_binding": {
    "domain": "vidtoolz.resolveLocationReceipt.v1",
    "binds": [
      "session_id",
      "document_path",
      "workflow_path",
      "governed_root",
      "authority_version",
      "manifest_sha256",
      "document_sha256",
      "workflow_sha256",
      "evidence_snapshot_digest",
      "location_validated"
    ],
    "bound_fields": [
      {
        "field": "session_id",
        "source": "caller-supplied session id, validated by session_id_errors and compared with both authority files' own claims",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "document_path",
        "source": "DERIVED: canonical_document_path(session_id) from the frozen governed root",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "workflow_path",
        "source": "DERIVED: canonical_workflow_path(session_id) from the frozen governed root (v1.15 V114-B4)",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "governed_root",
        "source": "FROZEN CONSTANT: GOVERNED_ATTACHMENT_ROOT; no caller input participates",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "authority_version",
        "source": "FROZEN CONSTANT: AUTHORITY_VERSION of this bundle",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "manifest_sha256",
        "source": "active authority: active['manifest_sha256'] of the reviewed manifest",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "document_sha256",
        "source": "sha256 of the exact EVIDENCE-SET.json bytes read no-follow from the canonical path",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "workflow_sha256",
        "source": "sha256 of the exact WORKFLOW.json bytes read no-follow from the canonical path (v1.15 V114-B4)",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "evidence_snapshot_digest",
        "source": "evidence_snapshot_digest(parse of those exact document bytes) under vidtoolz.resolveEvidenceSetSnapshot.v1 (v1.15 V114-B1)",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": true
      },
      {
        "field": "location_validated",
        "source": "CONSTANT True: the receipt is only ever computed after location_errors() returned empty; it is not a caller claim",
        "normative": true,
        "in_digest": true,
        "revalidated_live": true,
        "consumed_by_authorizing_core": false
      }
    ],
    "digest_law": "sha256(utf8(domain) + 0x0A + canonical_bytes(object of exactly these fields))",
    "recomputed_on_every_authorizing_call": true,
    "snapshot_domain_is_distinct": "vidtoolz.resolveEvidenceSetSnapshot.v1",
    "parity_law": "RUNTIME_BOUND_FIELDS == PUBLISHED_BOUND_FIELDS exactly, in both directions and in order; an omitted field or a claimed field the runtime does not bind is a validation failure"
  }
