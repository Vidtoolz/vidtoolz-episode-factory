#!/usr/bin/env bash
set -euo pipefail

PAGE="${1:-index.html}"
PORT="${2:-8010}"
LOG_DIR="${VIDTOOLZ_LAUNCHER_LOG_DIR:-/home/vidtoolz/.local/share/vidtoolz-launcher-logs}"
LOG_FILE="${LOG_DIR}/episode-factory-${PORT}.log"
CURL_BIN="${VIDTOOLZ_CURL_BIN:-curl}"
SS_BIN="${VIDTOOLZ_SS_BIN:-ss}"
BROWSER_BIN="${VIDTOOLZ_BROWSER_BIN:-xdg-open}"
NOTIFY_BIN="${VIDTOOLZ_NOTIFY_BIN:-notify-send}"
ENSURE_COCKPIT="${VIDTOOLZ_ENSURE_COCKPIT:-/home/vidtoolz/bin/ensure-cockpit.sh}"
HTTP_TIMEOUT="${VIDTOOLZ_HTTP_TIMEOUT:-2}"
URL="http://127.0.0.1:${PORT}/${PAGE}"

mkdir -p "$LOG_DIR"

log() {
  printf '%s [episode-factory] %s\n' "$(date --iso-8601=seconds)" "$*" | tee -a "$LOG_FILE"
}

fail() {
  log "ERROR: $*" >&2
  command -v "$NOTIFY_BIN" >/dev/null 2>&1 && \
    "$NOTIFY_BIN" -u critical "VIDTOOLZ Music Creator" "$*" || true
  exit "${2:-1}"
}

api_ready() {
  # Probe a non-gated GET that exists only on the Node Package Engine server.
  # (The old probe POSTed to /thumbnails, which is now write-nonce-gated and
  # returns 403, making the launcher wrongly think the server was missing.)
  "$CURL_BIN" -fsS --max-time "$HTTP_TIMEOUT" \
    "http://127.0.0.1:${PORT}/api/package-engine/status" >/dev/null 2>&1
}

page_ready() {
  "$CURL_BIN" -fsS --max-time "$HTTP_TIMEOUT" "$URL" >/dev/null 2>&1
}

if "$SS_BIN" -ltn | grep -q ":${PORT} "; then
  if ! api_ready; then
    fail "Port ${PORT} is occupied, but the Episode Factory API is not ready. No process was stopped; inspect the listener and vidtoolz-cockpit.service."
  fi
fi

if ! api_ready; then
  if [ "$PORT" = "8010" ] && [ -x "$ENSURE_COCKPIT" ]; then
    # The cockpit's own port is owned by vidtoolz-cockpit.service; bring it up
    # through systemd rather than a manual `node` start (which would collide
    # with the unit and cause an EADDRINUSE restart loop).
    log "Episode Factory is not ready; starting vidtoolz-cockpit.service."
    if ! "$ENSURE_COCKPIT" 8010 >>"$LOG_FILE" 2>&1; then
      fail "Episode Factory failed to start. Inspect: systemctl --user status vidtoolz-cockpit.service and ${LOG_FILE}"
    fi
  else
    fail "Episode Factory is not ready on port ${PORT}; only authoritative port 8010 may be started by this launcher."
  fi
fi

api_ready || fail "Episode Factory process exists but its API is not HTTP-ready on port ${PORT}. Inspect ${LOG_FILE}."
page_ready || fail "Episode Factory API is ready, but ${PAGE} is not reachable. Browser was not opened."

log "READY: API and page responded; opening ${URL}"
if [ "${VIDTOOLZ_NO_BROWSER:-0}" = "1" ]; then
  log "VIDTOOLZ_NO_BROWSER=1 — browser step skipped (URL: ${URL})"
elif ! "$BROWSER_BIN" "$URL" >>"$LOG_FILE" 2>&1; then
  fail "Music Creator is ready, but the browser could not be opened. Open ${URL} manually."
fi
